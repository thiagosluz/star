  SUSPENDED
  REMOVED
}

/// Natureza do vínculo com a instituição (FASE 14).
///
/// A inscrição pública (FASE 10) passou a criar vínculo para quem se inscreve em
/// evento aberto — correto para dar acesso, mas o modelo não distinguia esse
/// vínculo do vínculo de EQUIPE. Sem a distinção, a lista de membros da instituição
/// aparecia cheia de inscritos e a quota `maxMembers` do plano ficava impossível de
/// aplicar (contar vínculos passou a significar contar o público do evento).
///
/// `MEMBER` consome quota e aparece na lista de quem responde pela instituição.
/// `PARTICIPANT` dá acesso de participante e NÃO consome quota (ver
/// `src/domain/tenancy/membership-rules.ts`).
enum MembershipKind {
  MEMBER
  PARTICIPANT
}

