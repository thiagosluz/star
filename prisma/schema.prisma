/// Universo de onde os sorteados são tirados.
enum RaffleScope {
  /// Todos os presentes no evento (qualquer atividade).
  EVENT
  /// Presentes em atividades que acontecem na data de referência.
  DAY
  /// Presentes em UMA atividade, com carga horária mínima cumprida.
  ACTIVITY
}

enum RaffleStatus {
  /// Configurado, ainda não apurado.
  DRAFT
  /// Apurado: os vencedores estão gravados e não mudam mais.
  DRAWN
  /// Cancelado pelo organizador (o histórico permanece para auditoria).
  CANCELED
}

/// Papel da posição sorteada (FASE 16).
///
/// O suplente é sorteado NA MESMA apuração, logo depois dos titulares, e ocupa uma
/// posição própria: ninguém precisa "sortear de novo" quando um titular não aparece
/// para retirar o prêmio, e a ordem de reserva fica registrada e auditável.
enum RaffleWinnerKind {
  WINNER
  ALTERNATE
}

/// Sorteio de participantes elegíveis por PRESENÇA REAL.
///
/// O sorteio é uma operação de AUDITORIA, não um enfeite: guarda o universo
/// considerado, as regras aplicadas e o hash do resultado, para que a instituição
/// possa demonstrar depois COMO o sorteio foi feito.
model Raffle {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @db.Uuid
  eventId  String @db.Uuid

  /// Atividade alvo. Obrigatória apenas no escopo ACTIVITY.
  activityId String? @db.Uuid

  title       String  @db.VarChar(200)
  description String? @db.Text

  scope RaffleScope

  /// Data de referência do escopo DAY (dia no fuso da instituição, sem hora).
  referenceDate DateTime? @db.Date

  /// Piso de minutos assistidos para ser considerado presente.
  /// `0` = basta ter presença registrada (quem compareceu sem check-out conta).
  minAttendanceMinutes Int @default(0)

  /// Quantos vencedores devem ser sorteados.
  winnersCount Int

  /// Quantos SUPLENTES sortear, logo depois dos titulares (FASE 16). `0` = nenhum.
  alternatesCount Int @default(0)

  /// Sortear com chance proporcional aos MINUTOS assistidos (FASE 16).
  /// Desligado, todo elegível tem a mesma chance.
  weightByMinutes Boolean @default(false)

  /// Quando falso, quem já ganhou qualquer sorteio anterior deste evento sai do páreo.
  allowPriorEventWinners Boolean @default(false)

  /// Publicar o resultado na página pública do evento (FASE 16). Opt-in: publicar
  /// nome de ganhador é ato da instituição, e o nome sai mascarado por padrão.
  isPublic Boolean @default(false)

  status RaffleStatus @default(DRAFT)

  /// Quantas pessoas foram consideradas elegíveis na apuração (auditoria).
  eligibleCount        Int @default(0)
  /// Quantas presenças foram inspecionadas (auditoria do universo considerado).
  inspectedAttendances Int @default(0)

  drawnAt DateTime? @db.Timestamptz(6)

  /// SHA-256 do resultado canônico: regras + vencedores na ordem sorteada.
  /// Permite reconferir depois que a apuração não foi alterada.
  resultHash  String? @db.Char(64)
  /// Incrementa a cada apuração (um sorteio cancelado e refeito gera versão nova).
  drawVersion Int     @default(1)

  /// ─── Commit-reveal da semente (FASE 16) ─────────────────────────────────────
  /// O hash do resultado prova que o registro não foi alterado DEPOIS. Não prova
  /// que a apuração aconteceu depois do fechamento do credenciamento.
  ///
  /// `seedCommitment` é publicado na CRIAÇÃO (sha256 da semente), antes de haver
  /// elegíveis; a semente fica selada (`seedSealed`, AES-256-GCM) e só é revelada na
  /// apuração (`seedRevealed`). Quem conferir recalcula o hash da semente revelada,
  /// compara com o compromisso e reproduz o resultado com ela.
  seedCommitment String? @db.Char(64)
  seedSealed     String? @db.Text
  seedRevealed   String? @db.VarChar(128)

  /// Versão do conteúdo canônico assinado (1 = só titulares; 2 = suplentes, peso e
  /// papel por posição). Guardada porque o payload de auditoria é reconstruído a
  /// partir dela — subir a versão não pode invalidar o hash de apurações antigas.
  resultVersion Int @default(1)

  createdById String @db.Uuid

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  event     Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  activity  Activity?      @relation(fields: [activityId], references: [id], onDelete: SetNull)
  createdBy User           @relation("RaffleCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  winners   RaffleWinner[]

  @@index([tenantId, eventId, status])
  @@index([tenantId, eventId, drawnAt])
  @@map("raffles")
}

/// Vencedor de um sorteio. Imutável depois da apuração.
///
/// A tabela guarda as POSIÇÕES SORTEADAS, que incluem os suplentes desde a FASE 16
/// (`kind`). O nome da tabela ficou: renomear tabela sob RLS mexeria em policies e
/// grants para ganhar nada — a distinção está no dado, não no nome.
model RaffleWinner {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @db.Uuid
  raffleId String @db.Uuid
  userId   String @db.Uuid

  /// Ordem em que foi sorteado (1 = primeiro).
  position Int

  /// Titular do prêmio ou reserva (FASE 16).
  kind RaffleWinnerKind @default(WINNER)

  /// Minutos assistidos que fundamentaram a elegibilidade (auditoria).
  attendanceMinutes Int     @default(0)
  /// Presença que comprovou a elegibilidade (quando houve uma específica).
  attendanceId      String? @db.Uuid

  /// ─── Entrega do prêmio (FASE 16, item G2) ───────────────────────────────────
  /// Sem isso, "quem já retirou" ficava na memória de quem estava no balcão.
  deliveredAt  DateTime? @db.Timestamptz(6)
  deliveredById String?  @db.Uuid
  deliveryNote String?   @db.VarChar(300)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  raffle     Raffle      @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendance Attendance? @relation(fields: [attendanceId], references: [id], onDelete: SetNull)
  deliveredBy User?      @relation("RafflePrizeDeliveredBy", fields: [deliveredById], references: [id], onDelete: SetNull)

  /// A ANTIDUPLICAÇÃO É GARANTIDA PELO BANCO: o mesmo participante não pode
  /// aparecer duas vezes no mesmo sorteio, mesmo que a aplicação falhe.
  @@unique([raffleId, userId])
  /// Duas pessoas não podem ocupar a mesma posição.
  @@unique([raffleId, position])
  @@index([tenantId, userId])
  @@map("raffle_winners")
}

// ───────────────────────────────────────────────────────────────────────────────
//  TENANCY
// ───────────────────────────────────────────────────────────────────────────────

/// Instituição / empresa. Raiz do isolamento. NÃO possui RLS.
model Tenant {
  id   String @id @default(uuid(7)) @db.Uuid
  slug String @unique @db.VarChar(63)
  name String @db.VarChar(160)

  /// Domínio dedicado (ex.: eventos.ufba.br). Habilita resolução por host.
  customDomain String? @unique @db.VarChar(253)

  status TenantStatus @default(PENDING)
  plan   TenantPlan   @default(FREE)

  /// Quotas aplicadas pela camada de aplicação (billing/limites).
  maxEvents       Int    @default(3)
  maxStorageBytes BigInt @default(5368709120) // 5 GiB
  maxMembers      Int    @default(100)

  logoUrl      String? @db.VarChar(1024)
  primaryColor String? @db.VarChar(9)
  locale       String  @default("pt-BR") @db.VarChar(10)
  timezone     String  @default("America/Bahia") @db.VarChar(64)

  // ── Diretório público (FASE 9) ─────────────────────────────────────────────
  /// Aparece na vitrine global de instituições. Desligar é a saída para quem não
  /// quer ser descoberto, sem precisar sair da plataforma.
  isPublic    Boolean @default(true)
  /// Apresentação curta exibida no diretório e no card da instituição.
  description String? @db.Text
  /// Site institucional externo (validado por allowlist http/https).
  websiteUrl  String? @db.VarChar(1024)

  // ── Ciclo de vida (FASE 9) ─────────────────────────────────────────────────
  /// Quando o tráfego foi cortado. Nulo em instituição operante.
  suspendedAt      DateTime? @db.Timestamptz(6)
  /// Justificativa OBRIGATÓRIA da suspensão — exibida na página de bloqueio.
  suspensionReason String?   @db.VarChar(400)

  settings Json @default("{}")

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  memberships       UserTenantProfile[]
  roleAssignments   RoleAssignment[]
  events            Event[]
  rooms             Room[]
  activities        Activity[]
  activitySpeakers  ActivitySpeaker[]
  /// Palestrantes da instituição e seus materiais — FASE 25.
  speakerProfiles   SpeakerProfile[]
  speakerMaterials  SpeakerMaterial[]
  tracks            Track[]
  eventPages        EventPage[]
  eventPageVersions EventPageVersion[]
  pageBlocks        PageBlock[]
  mediaAssets       MediaAsset[]
  sponsorTiers      SponsorTier[]
  sponsors          Sponsor[]
  registrations     Registration[]
  attendances       Attendance[]
  submissions       Submission[]
  submissionAuthors SubmissionAuthor[]
  submissionFiles   SubmissionFile[]
  reviewAssignments ReviewAssignment[]
  reviews           Review[]
  reviewConflicts   ReviewConflict[]
  raffles           Raffle[]
  raffleWinners     RaffleWinner[]
  cardTemplates     CardTemplate[]
  userCards         UserCard[]
  xpProfiles        UserXpProfile[]
  xpTransactions    XpTransaction[]
  taskDefinitions   TaskDefinition[]
  userTaskProgress  UserTaskProgress[]
  certificates      Certificate[]
  auditLogs         AuditLog[]

  /// FASE 4 — avaliação por pares.
  reviewerExpertise    ReviewerExpertise[]
  conflictDeclarations ReviewerConflictDeclaration[]

  @@index([status])
  @@index([deletedAt])
  @@map("tenants")
}

// ───────────────────────────────────────────────────────────────────────────────
//  IDENTIDADE (GLOBAL — sem RLS por tenantId) — schema Better Auth
// ───────────────────────────────────────────────────────────────────────────────
//  Nomes em camelCase são exigidos pelo Better Auth. As anotações `@map`
//  preservam o nome camelCase na coluna (o padrão do Prisma já seria esse, mas
//  explicitá-las documenta que a escolha é do Better Auth, não nossa).
//
//  Estas tabelas recebem RLS com policies PRÓPRIAS (ver
//  docker/postgres/init/02-rls-policies.sql, seção 4): não têm `tenantId`
//  porque a identidade é global (ADR-002).

model User {
  id            String  @id @default(uuid(7)) @map("id") @db.Uuid
  name          String  @db.VarChar(160)
  email         String  @unique @db.VarChar(255)
  emailVerified Boolean @default(false)

  image        String? @db.VarChar(1024)
  /// Hash de senha (scrypt, gerado pelo Better Auth). Null em login social.
  passwordHash String? @db.VarChar(255)

  /// Perfil público gamificado.
  publicHandle    String? @unique @db.VarChar(63)
  bio             String? @db.VarChar(1000)
  headline        String? @db.VarChar(160)
  country         String? @db.VarChar(2)
  orcidId         String? @db.VarChar(19)
  lattesId        String? @db.VarChar(32)
  isPublicProfile Boolean @default(true)

  twoFactorEnabled Boolean   @default(false)
  banned           Boolean   @default(false)
  banReason        String?   @db.VarChar(500)
  banExpires       DateTime? @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  accounts          Account[]
  sessions          Session[]
  memberships       UserTenantProfile[]
  roleAssignments   RoleAssignment[]
  registrations     Registration[]
  attendances       Attendance[]
  submissions       Submission[]
  submissionAuthors SubmissionAuthor[]
  reviews           Review[]
  reviewAssignments ReviewAssignment[]
  activitySpeakers  ActivitySpeaker[]
  cards             UserCard[]
  xpTransactions    XpTransaction[]
  userProgress      UserTaskProgress[]
  xpProfiles        UserXpProfile[]
  certificates      Certificate[]
  auditLogs         AuditLog[]

  /// Configuração de revisor (áreas de atuação), uma por instituição — FASE 4.
  /// É uma lista porque a mesma pessoa pode revisar para instituições
  /// diferentes, com áreas de atuação diferentes em cada uma.
  reviewerExpertise    ReviewerExpertise[]
  /// Conflitos de interesse declarados pelo próprio revisor — FASE 4.
  conflictDeclarations ReviewerConflictDeclaration[] @relation("ConflictDeclaredBy")
  /// Conflitos em que esta pessoa é a PARTE conflitante — FASE 4.
  conflictsAgainstMe   ReviewerConflictDeclaration[] @relation("ConflictWithUser")

  /// Sorteios que esta pessoa criou — FASE 8.
  rafflesCreated Raffle[]       @relation("RaffleCreatedBy")
  /// Sorteios em que esta pessoa foi sorteada — FASE 8.
  raffleWins     RaffleWinner[]
  /// Prêmios de sorteio que esta pessoa ENTREGOU — FASE 16.
  rafflePrizesDelivered RaffleWinner[] @relation("RafflePrizeDeliveredBy")
  /// Versões de página pública que esta pessoa gravou — FASE 23.
  eventPageVersions EventPageVersion[] @relation("EventPageVersionCreatedBy")
  /// Imagens que esta pessoa enviou — FASE 24.
  mediaAssetsUploaded MediaAsset[] @relation("MediaAssetUploadedBy")

  /// Perfis de palestrante reivindicados por esta pessoa — FASE 25.
  speakerProfiles SpeakerProfile[] @relation("SpeakerProfileUser")
  /// Perfis de palestrante que esta pessoa cadastrou como organizadora — FASE 25.
  speakerProfilesCreated SpeakerProfile[] @relation("SpeakerProfileCreatedBy")
  /// Materiais de palestrante que esta pessoa enviou — FASE 25.
  speakerMaterialsUploaded SpeakerMaterial[] @relation("SpeakerMaterialUploadedBy")

  @@index([email])
  @@index([deletedAt])
  @@map("user")
}

/// Provedores de login (credencial, Google, GitHub, ORCID...).
model Account {
  id         String @id @default(uuid(7)) @db.Uuid
  accountId  String @db.VarChar(255)
  providerId String @db.VarChar(64)
  userId     String @db.Uuid

  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime? @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(6)
  scope                 String?   @db.VarChar(500)
  password              String?   @db.VarChar(255)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

/// Sessão de autenticação (Better Auth).
///
/// ATENÇÃO — o tenant ativo NÃO mora aqui.
/// O contexto ativo é resolvido por requisição a partir de um cookie assinado
/// (`ef_tenant`) e revalidado contra os vínculos reais do usuário. Ver ADR-009:
/// guardar o tenant na sessão criaria uma janela em que um usuário removido da
/// instituição continuaria operando com o contexto antigo.
model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  token     String   @unique @db.VarChar(512)
  userId    String   @db.Uuid
  expiresAt DateTime @db.Timestamptz(6)

  ipAddress String? @db.VarChar(64)
  userAgent String? @db.VarChar(500)

  /// Rastro do último tenant usado — apenas telemetria/UX, jamais autorização.
  lastTenantId   String? @db.Uuid
  /// Quem personificou esta sessão (suporte/impersonação auditada).
  impersonatedBy String? @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

/// Tokens efêmeros do fluxo de autenticação (verificação de e-mail, reset de
/// senha, magic link). O Better Auth valida em runtime que `updatedAt` existe —
/// a ausência desse campo é reportada como "Prisma schema mismatch".
model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String   @db.VarChar(255)
  value      String   @db.VarChar(512)
  expiresAt  DateTime @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)

  @@index([identifier])
  @@map("verification")
}

// ───────────────────────────────────────────────────────────────────────────────
//  RBAC — papéis por escopo (acúmulo de papéis e context switching)
// ───────────────────────────────────────────────────────────────────────────────

/// Vínculo pessoa↔instituição. É a tabela que o RLS protege para responder
/// "quem pode operar nesta instituição".
model UserTenantProfile {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @db.Uuid
  userId   String @db.Uuid

  status MembershipStatus @default(INVITED)

  /// Equipe (`MEMBER`) ou público de evento (`PARTICIPANT`). O default é MEMBER
  /// porque quem nasce por convite, provisionamento ou seed é equipe; a inscrição
  /// pública grava `PARTICIPANT` explicitamente.
  kind MembershipKind @default(MEMBER)

  /// Cargo/afiliação declarada dentro da instituição.
  jobTitle    String? @db.VarChar(120)
  department  String? @db.VarChar(120)
  institution String? @db.VarChar(200)
  /// Identificador do usuário no sistema de origem (SSO/legado).
  externalRef String? @db.VarChar(120)

  invitedById  String?   @db.Uuid
  invitedAt    DateTime? @db.Timestamptz(6)
  joinedAt     DateTime? @db.Timestamptz(6)
  lastAccessAt DateTime? @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId, status])
  /// Contagem de membros por instituição (quota do plano) e separação entre equipe
  /// e participantes nas listagens.
  @@index([tenantId, kind, status])
  @@index([tenantId, status])
  @@map("user_tenant_profiles")
}

/// Concessão de papel. `scope` + alvo definem onde o papel vale.
/// Ex.: REVIEWER aplicado a um EVENT; SPEAKER aplicado a uma ACTIVITY.
model RoleAssignment {
  id String @id @default(uuid(7)) @db.Uuid

  /// Instituição da concessão.
  ///
  /// NULO em `scope = PLATFORM` (FASE 9): a governança da plataforma não pertence
  /// a instituição alguma. A policy de RLS compara esta coluna com o contexto da
  /// transação, então uma linha com NULL é INVISÍVEL para a role de runtime — os
  /// papéis de plataforma só são lidos pela conexão administrativa.
  tenantId String? @db.Uuid
  userId   String  @db.Uuid

  role  RoleKey
  scope RoleScope

  /// Preenchido conforme `scope`. Nulos em TENANT e em PLATFORM.
  eventId    String? @db.Uuid
  activityId String? @db.Uuid

  /// Vigência. `expiresAt` permite papéis temporários (ex.: staff do dia).
  grantedAt   DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt   DateTime? @db.Timestamptz(6)
  grantedById String?   @db.Uuid
  reason      String?   @db.VarChar(300)
  revokedAt   DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant   Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  event    Event?    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  activity Activity? @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, role])
  @@index([tenantId, role, scope])
  @@index([eventId, role])
  @@index([activityId, role])
  @@index([userId, revokedAt])
  /// Papéis de PLATAFORMA são lidos por usuário, sem contexto de instituição.
  @@index([userId, scope])
  @@map("role_assignments")
}

// ───────────────────────────────────────────────────────────────────────────────
//  EVENTOS & ATIVIDADES
// ───────────────────────────────────────────────────────────────────────────────

model Event {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @db.Uuid

  slug        String  @db.VarChar(120)
  title       String  @db.VarChar(200)
  subtitle    String? @db.VarChar(300)
  summary     String? @db.VarChar(600)
  description String? @db.Text

  status   EventStatus   @default(DRAFT)
  modality EventModality @default(IN_PERSON)

  startsAt DateTime @db.Timestamptz(6)
  endsAt   DateTime @db.Timestamptz(6)

  timezone String @default("America/Bahia") @db.VarChar(64)

  /// Janelas de inscrição (independentes da janela do evento).
  registrationOpensAt  DateTime? @db.Timestamptz(6)
  registrationClosesAt DateTime? @db.Timestamptz(6)

  /// Janela de submissão de trabalhos.
  cfpOpensAt  DateTime? @db.Timestamptz(6)
  cfpClosesAt DateTime? @db.Timestamptz(6)

  venueName    String?  @db.VarChar(200)
  venueAddress String?  @db.VarChar(300)
  city         String?  @db.VarChar(120)
  state        String?  @db.VarChar(120)
  country      String?  @db.VarChar(2)
  onlineUrl    String?  @db.VarChar(1024)
  latitude     Decimal? @db.Decimal(10, 7)
  longitude    Decimal? @db.Decimal(10, 7)

  /// Lotação do evento como um todo. null = ilimitado; 0 = esgotado.
  capacity Int? @default(0)

  /// ─── Contadores denormalizados (reserva de vaga atômica) ──────────────────
  /// Mantidos pelos casos de uso de inscrição. A reserva de vaga é feita com
  /// um UPDATE condicional sobre `confirmedCount`, que o PostgreSQL serializa
  /// por linha — é o que impede superlotação sob concorrência sem
  /// `SELECT FOR UPDATE`. Ver src/domain/events/registration-rules.ts.
  confirmedCount Int @default(0)
  waitlistCount  Int @default(0)

  coverImageUrl  String? @db.VarChar(1024)
  logoUrl        String? @db.VarChar(1024)
  primaryColor   String? @db.VarChar(9)
  secondaryColor String? @db.VarChar(9)
  accentColor    String? @db.VarChar(9)

  /// Tema da landing page modular (tokens visuais, tipografia, raio, sombra).
  theme    Json @default("{}")
  /// Configurações de negócio: certificados, XP, regras de check-in.
  settings Json @default("{}")

  publishedAt DateTime? @db.Timestamptz(6)
  createdById String?   @db.Uuid

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  activities      Activity[]
  rooms           Room[]
  tracks          Track[]
  registrations   Registration[]
  submissions     Submission[]
  pages           EventPage[]
  sponsors        Sponsor[]
  sponsorTiers    SponsorTier[]
  roleAssignments RoleAssignment[]
  cardTemplates   CardTemplate[]
  taskDefinitions TaskDefinition[]
  certificates    Certificate[]
  attendances     Attendance[]
  userCards       UserCard[]
  xpTransactions  XpTransaction[]
  raffles         Raffle[]
  mediaAssets     MediaAsset[]

  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@index([tenantId, startsAt])
  @@index([status, startsAt])
  @@index([deletedAt])
  @@map("events")
}

/// Espaço físico/lógico com controle de lotação e conflito de horário.
model Room {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @db.Uuid
  eventId  String @db.Uuid

  name     String  @db.VarChar(120)
  building String? @db.VarChar(120)
  floor    String? @db.VarChar(40)
  capacity Int     @default(0)

  /// Recursos disponíveis: projetor, som, acessibilidade, etc.
  resources Json    @default("[]")
  mapUrl    String? @db.VarChar(1024)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  activities Activity[]

  @@unique([eventId, name])
  @@index([tenantId, eventId])
  @@map("rooms")
}

/// Atividade: palestra, minicurso, workshop, mesa-redonda, hackathon...
model Activity {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @db.Uuid
  eventId  String @db.Uuid

  slug        String         @db.VarChar(140)
  title       String         @db.VarChar(200)
  description String?        @db.Text
  type        ActivityType   @default(LECTURE)
  status      ActivityStatus @default(DRAFT)
  modality    EventModality  @default(IN_PERSON)

  startsAt DateTime @db.Timestamptz(6)
  endsAt   DateTime @db.Timestamptz(6)

  roomId String? @db.Uuid

  /// Lotação. `capacity` null = ILIMITADO; `0` = ESGOTADO.
  /// A distinção entre null e 0 é significativa: tratar 0 como ilimitado
  /// liberaria inscrições em uma atividade configurada como lotada.
  capacity        Int?    @default(0)
  waitlistEnabled Boolean @default(false)

  /// ─── Contadores denormalizados (reserva de vaga atômica) ──────────────────
  /// Fonte da verdade para ocupação. Ver `SEAT_AVAILABLE_PREDICATE` em
  /// src/domain/events/registration-rules.ts — o predicado de disponibilidade
  /// existe em um único lugar para que a semântica de null/0 não divirja.
  confirmedCount Int @default(0)
  waitlistCount  Int @default(0)

  /// Carga horária oficial em MINUTOS. Base para XP e certificados.
  workloadMinutes Int @default(60)

  /// Exige presença para emitir certificado / conceder XP.
  requiresAttendance   Boolean @default(true)
  /// Percentual mínimo de presença para considerar concluída (0-100).
  minAttendancePercent Int     @default(75)

  /// Habilita check-in por QR Code nesta atividade.
  checkInEnabled  Boolean   @default(true)
  checkInOpensAt  DateTime? @db.Timestamptz(6)
  checkInClosesAt DateTime? @db.Timestamptz(6)

  /// Valor de XP concedido pela conclusão (override do padrão do tenant).
  xpReward             Int     @default(0)
  /// Carta concedida na conclusão, se houver.
  rewardCardTemplateId String? @db.Uuid

  isFeatured    Boolean  @default(false)
  coverImageUrl String?  @db.VarChar(1024)
  tags          String[] @default([])
  metadata      Json     @default("{}")

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  room   Room?  @relation(fields: [roomId], references: [id], onDelete: SetNull)

  registrations   Registration[]
  attendances     Attendance[]
  submissions     Submission[]
  speakers        ActivitySpeaker[]
  roleAssignments RoleAssignment[]
  certificates    Certificate[]
  xpTransactions  XpTransaction[]
  raffles         Raffle[]
  /// Materiais de apoio publicados pelos palestrantes desta atividade — FASE 25.
  speakerMaterials SpeakerMaterial[]

  @@unique([eventId, slug])
  @@index([tenantId, eventId, status])
  @@index([eventId, startsAt])
  @@index([roomId, startsAt])
  @@index([tenantId, type])
  @@index([deletedAt])
  @@map("activities")
}

/// Vínculo entre uma ATIVIDADE e o PERFIL de um palestrante (N:N com metadados).
///
/// ─────────────────────────────────────────────────────────────────────────────
///  POR QUE O VÍNCULO NÃO GUARDA O PERFIL (FASE 25)
/// ─────────────────────────────────────────────────────────────────────────────
///  Nome, biografia, foto e instituição viviam AQUI até a FASE 24. Isso funcionava
///  enquanto o palestrante existia em uma única atividade — no momento em que ele
///  passou a ser uma PESSOA com portal próprio (que edita a própria bio e recebe um
///  certificado somando as atividades que ministrou), duas linhas do mesmo convidado
///  passariam a divergir: ele corrige a bio em uma e a outra continua errada.
///
///  O que fica aqui é o que é DO PAR: o papel nesta atividade ("Keynote" na
///  abertura, "Instrutor" no minicurso), a ordem na agenda, a carga horária
///  atribuída e a contribuição de conteúdo (ementa, requisitos, bibliografia).
///
///  `guestName` e companhia permanecem para as linhas legadas e como último
///  recurso de exibição: o nome canônico passou a ser `speakerProfile.name`.
model ActivitySpeaker {
  id         String  @id @default(uuid(7)) @db.Uuid
  tenantId   String  @db.Uuid
  activityId String  @db.Uuid
  userId     String? @db.Uuid

  /// Perfil do palestrante (FASE 25). Nulo apenas em linha legada que a migração
  /// não conseguiu associar — todo vínculo novo aponta para um perfil.
  speakerProfileId String? @db.Uuid

  /// Convidado externo sem conta na plataforma (legado: a identidade vive no perfil).
  guestName        String? @db.VarChar(160)
  guestEmail       String? @db.VarChar(255)
  guestInstitution String? @db.VarChar(200)
  guestBio         String? @db.Text

  /// Papel NESTA atividade. Sobrepõe o rótulo padrão do perfil quando preenchido.
  roleTitle String? @db.VarChar(120)

  /// Contribuição de conteúdo do palestrante para esta atividade (FASE 25).
  /// São PROPOSTAS atribuídas a quem as escreveu — a ementa oficial do evento
  /// continua sendo `Activity.description`, que a instituição controla.
  syllabus     String? @db.Text
  requirements String? @db.Text
  bibliography String? @db.Text

  isKeynote       Boolean @default(false)
  displayOrder    Int     @default(0)
  /// Carga horária atribuída a este palestrante (para certificado individual).
  workloadMinutes Int?    @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  /// Palestrante com conta na plataforma. `null` para convidado externo.
  /// A relação faltava desde a FASE 1 e impedia consultar o nome do palestrante
  /// junto do vínculo — descoberto ao montar a agenda pública na FASE 3.
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Perfil público do palestrante (FASE 25).
  speakerProfile SpeakerProfile? @relation(fields: [speakerProfileId], references: [id], onDelete: SetNull)

  @@unique([activityId, userId])
  @@index([tenantId, activityId])
  @@index([userId])
  @@index([tenantId, speakerProfileId])
  @@map("activity_speakers")
}

/// Palestrante da instituição — a PESSOA, não o vínculo com uma atividade (FASE 25).
///
/// ─────────────────────────────────────────────────────────────────────────────
///  POR QUE ESTA TABELA EXISTE
/// ─────────────────────────────────────────────────────────────────────────────
///  Um palestrante costuma falar em várias atividades e em várias edições do mesmo
///  evento. Sem um registro próprio, cada vínculo repetia o nome, a bio e a foto, e
///  o portal (onde ele edita o próprio perfil) não teria sobre o que escrever.
///
///  O perfil é da INSTITUIÇÃO (`tenantId` é a fronteira de RLS) e não do evento: a
///  mesma pessoa volta na edição seguinte, e o vínculo com a conta (`userId`) é o que
///  permite o acesso ao portal.
///
///  ─────────────────────────────────────────────────────────────────────────────
///  O CONVITE É GUARDADO COMO HASH
/// ─────────────────────────────────────────────────────────────────────────────
///  `inviteTokenHash` guarda o SHA-256 do token que a instituição entrega ao
///  palestrante. O token em claro não é gravado — quem lê a tabela (backup, suporte,
///  relatório) não consegue reivindicar o perfil de ninguém.
model SpeakerProfile {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @db.Uuid

  name        String  @db.VarChar(160)
  /// E-mail de contato. É a chave do vínculo automático por e-mail no portal.
  email       String? @db.VarChar(255)
  institution String? @db.VarChar(200)
  company     String? @db.VarChar(200)
  /// Rótulo padrão do palestrante ("Keynote", "Instrutor"…). Cada vínculo pode
  /// sobrepor com o papel daquela atividade.
  roleTitle   String? @db.VarChar(120)
  bio         String? @db.Text
  avatarUrl   String? @db.VarChar(1024)
  /// Redes e páginas: `{ linkedin?, github?, lattes?, website?, instagram?, youtube? }`.
  /// Validado no domínio (`sanitizeSocialLinks`) — só http(s) de host conhecido.
  socialLinks Json    @default("{}")

  /// Conta vinculada. `null` enquanto o palestrante não reivindicou o perfil.
  userId String? @db.Uuid

  /// SHA-256 do token de reivindicação + validade. Ver `InviteHash` no domínio.
  inviteTokenHash String?   @db.Char(64)
  inviteExpiresAt DateTime? @db.Timestamptz(6)
  inviteSentAt    DateTime? @db.Timestamptz(6)

  /// O palestrante confirmou os próprios dados? Perfil não confirmado ainda é
  /// exibido (a instituição o cadastrou), mas o portal o convida a revisar.
  isConfirmed Boolean @default(false)
  /// Aparece na vitrine pública? Falso esconde sem apagar — o palestrante pode
  /// pedir para sair da página sem que a instituição perca o cadastro.
  isPublic    Boolean @default(true)
  /// Ordem na vitrine (menor primeiro). A ordem na AGENDA é do vínculo.
  displayOrder Int    @default(0)

  createdById String? @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime? @db.Timestamptz(6)

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User?  @relation("SpeakerProfileUser", fields: [userId], references: [id], onDelete: SetNull)
  createdBy User?  @relation("SpeakerProfileCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  activityLinks ActivitySpeaker[]
  materials     SpeakerMaterial[]

  /// Um e-mail por instituição. Vários `null` convivem (o PostgreSQL trata NULL
  /// como distinto), o que permite cadastrar convidado ainda sem e-mail.
  @@unique([tenantId, email])
  @@index([tenantId, userId])
  @@index([tenantId, deletedAt])
  @@index([tenantId, displayOrder])
  @@map("speaker_profiles")
}

/// Material de apoio de uma atividade, publicado pelo palestrante (FASE 25).
///
/// ─────────────────────────────────────────────────────────────────────────────
///  O ARQUIVO NÃO É PÚBLICO: A VISIBILIDADE É UMA DECISÃO POR MATERIAL
/// ─────────────────────────────────────────────────────────────────────────────
///  Slides de aula podem ser abertos; uma apostila com dados de pacientes, não. O
///  bucket de materiais NÃO é público (ao contrário do bucket de imagens) e todo
///  download passa por URL assinada decidida na hora, com a visibilidade do material
///  como regra: `PUBLIC` (qualquer visitante), `ATTENDEES_ONLY` (inscrito confirmado
///  na atividade, o próprio palestrante e a equipe) ou `PRIVATE` (só o palestrante e
///  a equipe).
model SpeakerMaterial {
  id                String @id @default(uuid(7)) @db.Uuid
  tenantId          String @db.Uuid
  activityId        String @db.Uuid
  speakerProfileId  String @db.Uuid

  title       String  @db.VarChar(200)
  description String? @db.VarChar(600)
  /// `SLIDES` | `HANDOUT` | `LINK` | `ARTICLE` | `OTHER` (ver domínio).
  kind        String  @db.VarChar(32)
  /// `PUBLIC` | `ATTENDEES_ONLY` | `PRIVATE`.
  visibility  String  @db.VarChar(24) @default("PRIVATE")

  /// Arquivo enviado (upload direto ao storage). Nulo quando é link externo.
  storageBucket String? @db.VarChar(120)
  storageKey    String? @db.VarChar(1024)
  fileName      String? @db.VarChar(300)
  mimeType      String? @db.VarChar(120)
  sizeBytes     Int?
  checksum      String? @db.Char(64)

  /// Endereço público. Para link externo é o destino; para arquivo é a URL do objeto.
  url String? @db.VarChar(1024)

  displayOrder Int     @default(0)
  uploadedById String? @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)
  deletedAt    DateTime? @db.Timestamptz(6)

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  activity       Activity       @relation(fields: [activityId], references: [id], onDelete: Cascade)
  speakerProfile SpeakerProfile @relation(fields: [speakerProfileId], references: [id], onDelete: Cascade)
  uploadedBy     User?          @relation("SpeakerMaterialUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([tenantId, activityId, visibility])
  @@index([tenantId, speakerProfileId])
  @@index([deletedAt])
  @@map("speaker_materials")
}

// ───────────────────────────────────────────────────────────────────────────────
//  LANDING PAGE MODULAR
// ───────────────────────────────────────────────────────────────────────────────

model EventPage {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @db.Uuid
  eventId  String @db.Uuid

  slug        String  @db.VarChar(120)
  title       String  @db.VarChar(200)
  isHome      Boolean @default(false)
  isPublished Boolean @default(false)

  /// Data/hora em que a página entra no ar SOZINHA (FASE 23).
  ///
  /// A visibilidade pública é decidida na LEITURA (`publishAt <= now`), e não por
  /// um agendador: a plataforma não tem scheduler (é a mesma lacuna da manutenção
  /// de partições), e um agendador que não roda deixaria a campanha fora do ar sem
  /// ninguém perceber no dia. Assim, o banco é a fonte da verdade do horário.
  publishAt DateTime? @db.Timestamptz(6)

  /// Data/hora em que a página SAI do ar sozinha (FASE 24).
  ///
  /// Fecha a janela de exibição pelo mesmo mecanismo da entrada: decidido na
  /// leitura, no relógio do banco. Sem isso, uma campanha com data de término
  /// exigia alguém despublicando no dia.
  unpublishAt DateTime? @db.Timestamptz(6)

  /// SEO
  metaTitle       String? @db.VarChar(200)
  metaDescription String? @db.VarChar(320)
  ogImageUrl      String? @db.VarChar(1024)

  /// Overrides de tema específicos desta página.
  theme Json @default("{}")

  displayOrder Int @default(0)

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  event    Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  blocks   PageBlock[]
  versions EventPageVersion[]

  @@unique([eventId, slug])
  @@index([tenantId, eventId, isPublished])
  @@index([tenantId, eventId, publishAt])
  @@map("event_pages")
}

/// Imagem enviada pela instituição e servida pelo bucket público (FASE 24).
///
/// ─────────────────────────────────────────────────────────────────────────────
///  POR QUE A TABELA EXISTE, SE O ARQUIVO JÁ ESTAVA NO BUCKET
/// ─────────────────────────────────────────────────────────────────────────────
///  Até a FASE 23 o bucket ERA a biblioteca: a URL era gravada na coluna do evento
///  (capa, logotipo) ou no `content` do bloco (galeria), e ninguém sabia o que
///  havia sido enviado, por quem, quanto pesava nem o que era usado onde. O efeito
///  prático: imagem enviada e não usada virava lixo pago e invisível, e apagar um
///  arquivo em uso era impossível de decidir.
///
///  Aqui o arquivo passa a ter REGISTRO. A URL continua sendo a referência (o
///  conteúdo do bloco aceita imagens externas também), então a exclusão precisa
///  conferir o USO antes — ver `media-asset-service.ts`.
model MediaAsset {
  id       String  @id @default(uuid(7)) @db.Uuid
  tenantId String  @db.Uuid
  /// Evento em que a imagem foi enviada. Nulo = acervo da instituição.
  eventId  String? @db.Uuid

  bucket    String @db.VarChar(120)
  /// Chave do objeto no bucket (única por instituição).
  objectKey String @db.VarChar(1024)
  /// URL pública — é ela que a página renderiza.
  url       String @db.VarChar(1024)

  fileName  String @db.VarChar(300)
  mimeType  String @db.VarChar(120)
  sizeBytes Int
  /// SHA-256 do conteúdo: permite detectar o MESMO arquivo enviado duas vezes.
  checksum  String @db.Char(64)

  /// Finalidade do envio (`COVER`, `LOGO`, `SPONSOR_LOGO`, `GALLERY`).
  target String @db.VarChar(32)

  uploadedById String? @db.Uuid

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  event      Event?    @relation(fields: [eventId], references: [id], onDelete: SetNull)
  uploadedBy User?     @relation("MediaAssetUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@unique([tenantId, objectKey])
  @@index([tenantId, createdAt])
  @@index([tenantId, eventId])
  @@index([tenantId, checksum])
  @@map("media_assets")
}

/// Fotografia do conteúdo da página num instante (FASE 23, item E12).
///
/// A trilha de auditoria registra QUE houve mudança, com resumo — não o conteúdo
/// anterior. Um bloco sobrescrito por engano precisava de suporte. Esta tabela
/// guarda a página inteira (blocos incluídos) para permitir restauração.
///
/// O `checksum` existe para NÃO gravar versões idênticas: salvar o formulário sem
/// mexer em nada geraria uma linha por clique, e a história de vinte versões iguais
/// esconderia a que importa.
model EventPageVersion {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @db.Uuid
  pageId   String @db.Uuid

  /// Por que esta versão foi gravada (rótulo curto, em pt-BR).
  reason String @db.VarChar(120)

  /// Página + blocos no momento da gravação (formato canônico, ver page-version-rules).
  snapshot Json
  /// SHA-256 do snapshot canonicalizado — deduplica versões idênticas.
  checksum String @db.Char(64)

  createdById String? @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  tenant Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  page   EventPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  /// Autor da alteração (nulo se a conta for removida — a versão permanece).
  createdBy User?  @relation("EventPageVersionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tenantId, pageId, createdAt])
  @@index([createdById])
  @@map("event_page_versions")
}

/// Bloco visual da landing page. `content` é validado por schema Zod na
/// camada de aplicação conforme `type` (union discriminada).
model PageBlock {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @db.Uuid
  pageId   String @db.Uuid

  type    PageBlockType
  content Json          @default("{}")
  /// Overrides visuais do bloco (paleta, espaçamento, animação).
  style   Json          @default("{}")

  displayOrder Int     @default(0)
  isVisible    Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  page   EventPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([tenantId, pageId, displayOrder])
  @@map("page_blocks")
}

// ───────────────────────────────────────────────────────────────────────────────
//  PATROCINADORES
// ───────────────────────────────────────────────────────────────────────────────

/// Cota configurável por evento (Diamante, Ouro, Prata ou cota customizada).
model SponsorTier {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @db.Uuid
  eventId  String @db.Uuid

  key         SponsorTierKey @default(CUSTOM)
  name        String         @db.VarChar(80)
  description String?        @db.VarChar(400)
  color       String?        @db.VarChar(9)
  /// Ordem de exibição (Diamante = 0).
  rank        Int            @default(0)
  /// Valor comercial da cota, para relatórios financeiros.
  priceCents  Int            @default(0)
  currency    String         @default("BRL") @db.VarChar(3)
  /// Quantidade máxima de patrocinadores nesta cota (0 = ilimitado).
  maxSponsors Int            @default(0)
  /// O que a cota entrega (logo no site, stand, palestra...).
  benefits    Json           @default("[]")

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  event    Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sponsors Sponsor[]

  @@unique([eventId, name])
  @@index([tenantId, eventId, rank])
  @@map("sponsor_tiers")
}

model Sponsor {
  id       String  @id @default(uuid(7)) @db.Uuid
  tenantId String  @db.Uuid
  eventId  String? @db.Uuid
  tierId   String? @db.Uuid

  name        String  @db.VarChar(160)
  slug        String  @db.VarChar(120)
  description String? @db.Text
  logoUrl     String? @db.VarChar(1024)
  websiteUrl  String? @db.VarChar(1024)

  contactName  String? @db.VarChar(160)
  contactEmail String? @db.VarChar(255)
  contactPhone String? @db.VarChar(40)
  /// Documento fiscal (CNPJ/CPF) — dado sensível, mascarado em logs.
  taxId        String? @db.VarChar(32)

  isActive           Boolean   @default(true)
  /// Contrato/ativo veiculado.
  contractUrl        String?   @db.VarChar(1024)
  contractValueCents Int?      @default(0)
  contractStart      DateTime? @db.Timestamptz(6)
  contractEnd        DateTime? @db.Timestamptz(6)

  /// Cadastro de ORIGEM, quando este foi copiado de outra edição (FASE 24).
  ///
  /// A cópia da FASE 23 criava um cadastro independente, e corrigir o site na
  /// edição de origem não alcançava as demais. O vínculo NÃO transforma a cópia em
  /// referência — cada edição tem contrato e valor próprios —, mas permite
  /// SINCRONIZAR os dados que são da empresa: nome, descrição, site, logotipo e
  /// contato.
  sourceSponsorId String? @db.Uuid

  displayOrder Int  @default(0)
  metadata     Json @default("{}")

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  event  Event?       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tier   SponsorTier? @relation(fields: [tierId], references: [id], onDelete: SetNull)
  /// Cadastro do qual este foi copiado.
  source Sponsor?     @relation("SponsorCopiedFrom", fields: [sourceSponsorId], references: [id], onDelete: SetNull)
  /// Cópias geradas a partir deste cadastro.
  copies Sponsor[]    @relation("SponsorCopiedFrom")

  @@unique([tenantId, slug])
  @@index([tenantId, eventId, isActive])
  @@index([tierId])
  @@index([sourceSponsorId])
  @@map("sponsors")
}

// ───────────────────────────────────────────────────────────────────────────────
//  INSCRIÇÕES, PRESENÇA & CREDENCIAMENTO
// ───────────────────────────────────────────────────────────────────────────────

/// Inscrição em uma atividade. `userId` é pessoa global.
/// Também cobre inscrição "no evento" via Activity do tipo OTHER/check-in geral.
model Registration {
  id         String  @id @default(uuid(7)) @db.Uuid
  tenantId   String  @db.Uuid
  eventId    String  @db.Uuid
  activityId String? @db.Uuid
  userId     String  @db.Uuid

  status RegistrationStatus @default(PENDING)

  /// Posição na lista de espera quando `status = WAITLISTED`.
  waitlistPosition Int? @default(0)

  /// Consentimentos LGPD (imagem, dados, comunicações).
  consentImage Boolean   @default(false)
  consentData  Boolean   @default(false)
  consentAt    DateTime? @db.Timestamptz(6)

  /// Requisitos de acessibilidade / dieta informados na inscrição.
  accessibilityNotes String? @db.VarChar(600)
  dietaryNotes       String? @db.VarChar(300)

  /// Respostas de formulário dinâmico da inscrição.
  formResponses Json @default("{}")

  /// Credenciamento: token opaco impresso no QR Code do badge.
  badgeToken    String?   @unique @db.VarChar(64)
  checkedInAt   DateTime? @db.Timestamptz(6)
  checkedInById String?   @db.Uuid

  canceledAt   DateTime? @db.Timestamptz(6)
  cancelReason String?   @db.VarChar(300)

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  event    Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  activity Activity? @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  attendances    Attendance[]
  xpTransactions XpTransaction[]

  /// NÃO existe `@@unique([activityId, userId])` aqui de propósito.
  ///
  /// Um cancelamento é TERMINAL: a linha permanece com status CANCELED. Se a
  /// unicidade fosse global, um participante que cancelou jamais conseguiria se
  /// inscrever de novo. A unicidade efetiva é garantida por um índice único
  /// PARCIAL no banco, aplicado apenas a inscrições vivas:
  ///
  ///     CREATE UNIQUE INDEX ... ON registrations ("activityId", "userId")
  ///       WHERE status IN ('PENDING','CONFIRMED','WAITLISTED','ATTENDED')
  ///
  /// Esse índice é criado pela migração `registration_live_unique`
  /// (ver prisma/migrations) porque o Prisma Schema Language ainda não
  /// expressa índices parciais.
  @@index([tenantId, eventId, status])
  @@index([tenantId, userId, status])
  @@index([eventId, status])
  @@index([badgeToken])
  @@map("registrations")
}

/// Registro de presença. Um por check-in/check-out — permite múltiplos
/// registros por atividade (entrada + saída) e auditoria completa.
model Attendance {
  id             String  @id @default(uuid(7)) @db.Uuid
  tenantId       String  @db.Uuid
  eventId        String  @db.Uuid
  activityId     String? @db.Uuid
  registrationId String? @db.Uuid
  userId         String  @db.Uuid

  status AttendanceStatus @default(PRESENT)
  source AttendanceSource

  /// Janela efetivamente cumprida (calculada entre check-in e check-out).
  checkedInAt     DateTime  @db.Timestamptz(6)
  checkedOutAt    DateTime? @db.Timestamptz(6)
  minutesAttended Int?      @default(0)

  /// Geolocalização opcional do check-in (auditoria antifraude).
  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)
  /// IP/dispositivo que originou o registro.
  ipAddress String?  @db.VarChar(64)
  userAgent String?  @db.VarChar(500)

  /// Quem validou (staff), quando manual.
  validatedById String? @db.Uuid
  /// Nonce do QR Code consumido, para impedir replay.
  qrNonce       String? @db.VarChar(64)
  notes         String? @db.VarChar(500)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  event        Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  activity     Activity?      @relation(fields: [activityId], references: [id], onDelete: Cascade)
  registration Registration?  @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  certificates Certificate[]
  raffleWins   RaffleWinner[]

  @@index([tenantId, activityId, userId])
  @@index([tenantId, eventId, checkedInAt])
  @@index([registrationId])
  @@index([qrNonce])
  @@map("attendances")
}

// ───────────────────────────────────────────────────────────────────────────────
//  SUBMISSÕES & PEER REVIEW
// ───────────────────────────────────────────────────────────────────────────────

/// Trilha temática da chamada de trabalhos.
model Track {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @db.Uuid
  eventId  String @db.Uuid

  slug        String  @db.VarChar(120)
  name        String  @db.VarChar(160)
  description String? @db.Text
  color       String? @db.VarChar(9)

  /// Coordenador da trilha.
  chairId String? @db.Uuid

  /// Limite de submissões por autor nesta trilha (0 = ilimitado).
  maxSubmissionsPerAuthor Int     @default(0)
  /// Exige versão cega para submissão.
  requiresBlindReview     Boolean @default(true)

  /// Rubrica de avaliação: lista de critérios com peso e escala.
  /// Contrato validado por `validateRubric` (src/domain/review/review-rules.ts).
  /// [{ key, label, weight, maxScore, description }]
  reviewRubric Json @default("[]")

  /// Nota mínima (0-100) para sugestão de aceite.
  acceptanceThreshold Decimal @default(70) @db.Decimal(5, 2)
  /// Nota abaixo da qual a sugestão é rejeição.
  rejectThreshold     Decimal @default(45) @db.Decimal(5, 2)

  /// Quantos pareceres a trilha exige para considerar a avaliação concluída.
  /// Configurável: pós-graduação costuma exigir 3, iniciação científica 2.
  requiredReviews Int @default(2)

  isActive Boolean @default(true)

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@unique([eventId, slug])
  @@index([tenantId, eventId, isActive])
  @@map("tracks")
}

model Submission {
  id         String  @id @default(uuid(7)) @db.Uuid
  tenantId   String  @db.Uuid
  eventId    String  @db.Uuid
  trackId    String? @db.Uuid
  activityId String? @db.Uuid

  /// Código público de protocolo (ex.: ABC123).
  protocol String   @db.VarChar(20)
  title    String   @db.VarChar(300)
  abstract String   @db.Text
  keywords String[] @default([])
  language String   @default("pt-BR") @db.VarChar(10)

  status SubmissionStatus @default(DRAFT)

  /// Autor que realizou a submissão (corresponding author).
  submittedById String    @db.Uuid
  submittedAt   DateTime? @db.Timestamptz(6)

  /// Resultado final da avaliação.
  finalScore    Decimal?  @db.Decimal(6, 2)
  decisionAt    DateTime? @db.Timestamptz(6)
  decisionById  String?   @db.Uuid
  decisionNotes String?   @db.Text

  /// Apresentação aprovada (sessão, horário, sala).
  presentationScheduledAt DateTime? @db.Timestamptz(6)
  presentationRoomId      String?   @db.Uuid
  presentationFormat      String?   @db.VarChar(40)

  /// Versão corrente da submissão. Incrementada a cada reenvio durante a
  /// revisão, para que o parecer continue apontando ao artefato avaliado.
  version Int @default(1)

  /// Snapshot da identidade dos autores no momento do envio.
  ///
  /// Existe porque a revisão cega precisa de uma versão SEM autoria: guardar o
  /// snapshot permite remover os dados de identificação da resposta destinada ao
  /// revisor de forma ESTRUTURAL (campo ausente), não apenas cosmética.
  blindSnapshot Json @default("{}")

  metadata Json @default("{}")

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  event    Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  track    Track?    @relation(fields: [trackId], references: [id], onDelete: SetNull)
  activity Activity? @relation(fields: [activityId], references: [id], onDelete: SetNull)
  author   User      @relation(fields: [submittedById], references: [id], onDelete: Restrict)

  authors        SubmissionAuthor[]
  files          SubmissionFile[]
  assignments    ReviewAssignment[]
  reviews        Review[]
  conflicts      ReviewConflict[]
  xpTransactions XpTransaction[]

  @@unique([tenantId, protocol])
  @@index([tenantId, eventId, status])
  @@index([eventId, trackId, status])
  @@index([submittedById])
  @@index([tenantId, status, submittedAt])
  @@map("submissions")
}

/// Coautoria com ordem de crédito e afiliação — base do certificado de autor.
model SubmissionAuthor {
  id           String  @id @default(uuid(7)) @db.Uuid
  tenantId     String  @db.Uuid
  submissionId String  @db.Uuid
  userId       String? @db.Uuid

  /// Coautor sem conta na plataforma.
  guestName        String? @db.VarChar(160)
  guestEmail       String? @db.VarChar(255)
  guestInstitution String? @db.VarChar(200)
  guestOrcidId     String? @db.VarChar(19)

  institution     String? @db.VarChar(200)
  /// Ordem de autoria (1 = primeiro autor).
  authorOrder     Int     @default(1)
  isCorresponding Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([submissionId, authorOrder])
  @@index([tenantId, submissionId])
  @@index([userId])
  @@map("submission_authors")
}

/// Arquivo armazenado em S3/MinIO. Metadados suficientes para auditoria
/// de integridade (hash, tamanho, tipo) e para varredura antivírus.
model SubmissionFile {
  id           String @id @default(uuid(7)) @db.Uuid
  tenantId     String @db.Uuid
  submissionId String @db.Uuid

  kind SubmissionFileKind @default(BLIND_PDF)

  /// Chave no bucket (tenant-scoped: tenants/{tenantId}/events/{eventId}/...).
  storageKey String @db.VarChar(1024)
  bucket     String @db.VarChar(120)
  fileName   String @db.VarChar(300)
  mimeType   String @db.VarChar(120)
  sizeBytes  BigInt
  /// SHA-256 do conteúdo — detecta substituição e deduplica.
  checksum   String @db.Char(64)
  /// Versão do arquivo (reenvios em revisão).
  version    Int    @default(1)

  isCurrent  Boolean @default(true)
  /// Resultado da varredura antivírus (ClamAV/serviço externo).
  scanStatus String  @default("PENDING") @db.VarChar(20)

  uploadedById String?   @db.Uuid
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt    DateTime? @db.Timestamptz(6)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, kind, version])
  @@index([tenantId, submissionId, isCurrent])
  @@index([checksum])
  @@map("submission_files")
}

/// Atribuição de parecerista. Registra afinidade e status do convite.
model ReviewAssignment {
  id           String @id @default(uuid(7)) @db.Uuid
  tenantId     String @db.Uuid
  submissionId String @db.Uuid
  reviewerId   String @db.Uuid

  status ReviewStatus @default(INVITED)

  /// Pontuação de afinidade (0-100) calculada na distribuição automática.
  affinityScore Decimal? @db.Decimal(5, 2)
  /// Justificativa da escolha (matching por keywords, trilha, histórico).
  matchReason   String?  @db.VarChar(400)

  isBlind Boolean @default(true)

  invitedAt   DateTime  @default(now()) @db.Timestamptz(6)
  respondedAt DateTime? @db.Timestamptz(6)
  dueAt       DateTime? @db.Timestamptz(6)

  assignedById String? @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewer   User       @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  reviews Review[]

  @@unique([submissionId, reviewerId])
  @@index([tenantId, reviewerId, status])
  @@index([submissionId, status])
  @@index([dueAt])
  @@map("review_assignments")
}

/// Parecer. Notas por critério ficam em `scores` (JSON validado pela rubrica
/// da trilha) e o total ponderado em `weightedScore`.
model Review {
  id           String  @id @default(uuid(7)) @db.Uuid
  tenantId     String  @db.Uuid
  submissionId String  @db.Uuid
  reviewerId   String  @db.Uuid
  /// Atribuição que originou este parecer (rastreabilidade do convite).
  assignmentId String? @db.Uuid

  status         ReviewStatus          @default(IN_PROGRESS)
  recommendation ReviewRecommendation?

  /// Notas por critério: { "originality": 8, "methodology": 6 }
  scores        Json     @default("{}")
  /// Média ponderada calculada (0-100), persistida para ordenação/relatórios.
  weightedScore Decimal? @db.Decimal(6, 2)

  /// Comentários para o comitê (não visíveis ao autor).
  confidentialComments String? @db.Text
  /// Comentários devolvidos ao autor.
  feedbackToAuthor     String? @db.Text

  isBlind Boolean @default(true)

  /// Versão da submissão que este parecer avaliou.
  ///
  /// Registrado no momento da emissão. Sem isso, um reenvio durante a revisão
  /// tornaria impossível saber qual arquivo fundamentou o parecer — e o parecer
  /// perderia valor como registro.
  submissionVersion Int @default(1)

  /// Detalhamento da nota ponderada, para auditoria.
  /// [{ key, raw, maxScore, weight, ratio, points }]
  scoreBreakdown Json @default("[]")

  submittedAt DateTime? @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime? @db.Timestamptz(6)

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  submission Submission        @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewer   User              @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  assignment ReviewAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  xpTransactions XpTransaction[]

  @@unique([submissionId, reviewerId])
  @@index([tenantId, reviewerId, status])
  @@index([submissionId, status])
  @@map("reviews")
}

/// Conflito de interesse detectado ou declarado. Bloqueia atribuição.
model ReviewConflict {
  id           String @id @default(uuid(7)) @db.Uuid
  tenantId     String @db.Uuid
  submissionId String @db.Uuid
  /// Usuário conflitante (potencial revisor ou autor).
  userId       String @db.Uuid

  type         ConflictType
  /// Como foi descoberto: regra automática ou declaração.
  isDetected   Boolean      @default(true)
  reason       String?      @db.VarChar(500)
  /// Quem declarou o conflito (null se detectado por regra).
  declaredById String?      @db.Uuid
  resolvedAt   DateTime?    @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, userId, type])
  @@index([tenantId, submissionId])
  @@index([userId])
  @@map("review_conflicts")
}

/// ───────────────────────────────────────────────────────────────────────────────
///  Áreas de atuação do revisor
/// ───────────────────────────────────────────────────────────────────────────────
///  Sem isso, a distribuição de pareceristas vira sorteio: quem não domina o
///  tema escreve um parecer superficial e o comitê decide com informação fraca.
///
///  Escopo por TENANT porque a mesma pessoa pode atuar em áreas diferentes em
///  instituições diferentes (ex.: revisora de saúde pública na FIOCRUZ e de
///  ciência de dados na UFBA).
model ReviewerExpertise {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @db.Uuid
  userId   String @db.Uuid

  /// Áreas de interesse em texto livre. Alimentam o casamento por afinidade
  /// (src/domain/review/affinity.ts), que tokeniza e compara por Jaccard.
  expertiseKeywords String[] @default([])

  /// Trilhas em que a pessoa se declara apta a avaliar. É uma declaração
  /// EXPLÍCITA de área e por isso pesa mais que a inferência por palavras.
  preferredTrackIds String[] @default([])

  /// Limite individual de pareceres simultâneos (0 = sem limite).
  /// Serve para distribuir carga e evitar que poucos revisores concentrem tudo.
  maxConcurrentAssignments Int @default(5)

  /// Contador denormalizado de pareceres concluídos, usado como sinal de
  /// experiência na afinidade (satura em 10).
  completedReviewCount Int @default(0)

  /// Indisponível para novos pareceres (férias, licença).
  isAvailable Boolean @default(true)

  /// Instituição declarada para fins de conflito de interesse. Pode divergir da
  /// instituição do vínculo (`UserTenantProfile`) quando a pessoa revisa para uma
  /// instituição diferente da sua.
  declaredInstitution      String? @db.VarChar(200)
  /// Domínio de e-mail institucional. Preferido sobre o domínio do e-mail no
  /// cálculo de conflito, porque é uma declaração explícita.
  institutionalEmailDomain String? @db.VarChar(120)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId, isAvailable])
  @@map("reviewer_expertise")
}

/// ───────────────────────────────────────────────────────────────────────────────
///  Declaração de conflito de interesse
/// ───────────────────────────────────────────────────────────────────────────────
///  Permite que o revisor informe proativamente situações que o sistema não
///  consegue inferir: coautoria pregressa, relação de orientação com um autor
///  específico, vínculo financeiro.
///
///  Duas granularidades no mesmo modelo:
///    • `submissionId` preenchido  → conflito com UMA submissão específica
///    • `submissionId` nulo        → conflito com uma PESSOA, válido para todas
///      as submissões em que ela apareça como autora
model ReviewerConflictDeclaration {
  id               String  @id @default(uuid(7)) @db.Uuid
  tenantId         String  @db.Uuid
  /// Quem declara (o revisor).
  reviewerId       String  @db.Uuid
  /// Pessoa com quem existe conflito. Nulo quando o conflito é com a submissão.
  conflictedUserId String? @db.Uuid
  /// Submissão específica. Nulo quando o conflito é com a pessoa.
  submissionId     String? @db.Uuid

  type   ConflictType
  reason String?      @db.VarChar(500)

  /// Vigência: um conflito pode ser temporário (ex.: orientação em andamento).
  expiresAt DateTime? @db.Timestamptz(6)
  revokedAt DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant         Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Quem declarou o conflito.
  reviewer       User   @relation("ConflictDeclaredBy", fields: [reviewerId], references: [id], onDelete: Cascade)
  /// Pessoa com quem existe o conflito (quando o conflito é com alguém
  /// específico, e não com uma submissão).
  conflictedUser User?  @relation("ConflictWithUser", fields: [conflictedUserId], references: [id], onDelete: Cascade)

  @@index([tenantId, reviewerId, revokedAt])
  @@index([tenantId, conflictedUserId])
  @@index([tenantId, submissionId])
  @@map("reviewer_conflict_declarations")
}

// ───────────────────────────────────────────────────────────────────────────────
//  GAMIFICAÇÃO — CARDS COLECIONÁVEIS
// ───────────────────────────────────────────────────────────────────────────────

/// Template de carta colecionável. `art` descreve a arte/efeito visual
/// (gradiente, sprite, animação, moldura) renderizada no front.
model CardTemplate {
  id       String  @id @default(uuid(7)) @db.Uuid
  tenantId String  @db.Uuid
  eventId  String? @db.Uuid

  slug        String  @db.VarChar(120)
  name        String  @db.VarChar(160)
  description String? @db.Text
  lore        String? @db.Text

  rarity        CardRarity
  /// Nível mínimo para a carta poder ser concedida/equipada.
  levelRequired Int        @default(1)

  /// Paleta dinâmica: { primary, secondary, glow, text }
  palette Json @default("{}")
  /// Arte e efeitos: { imageUrl, frameUrl, animation, particle, foil }
  art     Json @default("{}")

  /// Gatilho padrão de distribuição.
  trigger          CardTrigger
  /// Condição extra avaliada pela engine: { activityId, trackId, threshold, streak }
  triggerCondition Json        @default("{}")

  /// Peso na distribuição aleatória dentro da raridade (maior = mais comum).
  dropWeight     Int       @default(100)
  /// Carta não pode ser obtida após esta data (edições limitadas).
  availableUntil DateTime? @db.Timestamptz(6)
  /// Limite global de emissões (0 = ilimitado) — controla escassez.
  maxSupply      Int       @default(0)
  /// Contador denormalizado de emissões, para checagem rápida de escassez.
  mintedCount    Int       @default(0)

  isActive Boolean @default(true)
  /// Carta não negociável/oculta do catálogo público.
  isSecret Boolean @default(false)

  metadata Json @default("{}")

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  event  Event?  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  userCards       UserCard[]
  taskDefinitions TaskDefinition[]

  @@unique([tenantId, slug])
  @@index([tenantId, eventId, rarity])
  @@index([tenantId, trigger, isActive])
  @@map("card_templates")
}

/// Carta obtida por um usuário. A mesma carta pode ser colecionada em
/// múltiplos tenants (cada tenant tem seu próprio álbum).
model UserCard {
  id             String  @id @default(uuid(7)) @db.Uuid
  tenantId       String  @db.Uuid
  userId         String  @db.Uuid
  cardTemplateId String  @db.Uuid
  eventId        String? @db.Uuid

  /// Nível da carta no álbum do usuário (cartas evoluem com XP).
  level    Int     @default(1)
  /// Quantidade de cópias (duplicatas viram "poeira"/crafting).
  quantity Int     @default(1)
  /// Se está fixada no perfil público (destaque estético).
  isPinned Boolean @default(false)
  /// Carta em foil/holográfica — variante rara da mesma carta.
  isFoil   Boolean @default(false)

  source      CardTrigger
  /// Origem concreta: activityId, submissionId, reviewId...
  sourceRef   String?     @db.VarChar(120)
  grantedById String?     @db.Uuid
  grantedAt   DateTime    @default(now()) @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardTemplate CardTemplate @relation(fields: [cardTemplateId], references: [id], onDelete: Cascade)
  event        Event?       @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@unique([tenantId, userId, cardTemplateId, isFoil])
  @@index([tenantId, userId, grantedAt])
  @@index([cardTemplateId])
  @@index([userId, isPinned])
  @@map("user_cards")
}

// ───────────────────────────────────────────────────────────────────────────────
//  GAMIFICAÇÃO — ENGINE DE XP, NÍVEIS & MISSÕES
// ───────────────────────────────────────────────────────────────────────────────

/// Perfil de XP agregado. Denormalizado de propósito: leitura O(1) no perfil
/// público. A verdade contábil é `XpTransaction` (append-only).
model UserXpProfile {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @db.Uuid
  userId   String @db.Uuid

  totalXp   Int     @default(0)
  /// XP gasto/resetado em temporadas (season).
  spentXp   Int     @default(0)
  /// XP da temporada corrente.
  seasonXp  Int     @default(0)
  seasonKey String? @db.VarChar(20)

  level         Int @default(1)
  /// Nível de prestígio (prestígio é reset de nível mantendo recompensas).
  prestigeLevel Int @default(0)

  currentStreak  Int       @default(0)
  longestStreak  Int       @default(0)
  lastActivityAt DateTime? @db.Timestamptz(6)

  /// Moldura/badge equipados no perfil público.
  equippedFrame String? @db.VarChar(80)
  equippedTitle String? @db.VarChar(80)
  equippedBadge String? @db.VarChar(80)

  cardsCollected Int @default(0)
  tasksCompleted Int @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId, totalXp])
  @@index([tenantId, level])
  @@map("user_xp_profiles")
}

/// Livro-razão de XP. Append-only. `idempotencyKey` impede crédito duplicado
/// (ex.: dois check-ins no mesmo QR Code).
model XpTransaction {
  id       String  @id @default(uuid(7)) @db.Uuid
  tenantId String  @db.Uuid
  userId   String  @db.Uuid
  eventId  String? @db.Uuid

  amount Int // pode ser negativo (estorno/ajuste)
  source XpSourceKind
  reason String?      @db.VarChar(300)

  /// Referências de origem para rastreabilidade.
  activityId     String? @db.Uuid
  submissionId   String? @db.Uuid
  reviewId       String? @db.Uuid
  registrationId String? @db.Uuid

  /// Saldo após o lançamento (auditoria contábil).
  balanceAfter Int? @default(0)

  /// Chave única de idempotência da regra que gerou o crédito.
  idempotencyKey String @unique @db.VarChar(160)

  createdById String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  event        Event?        @relation(fields: [eventId], references: [id], onDelete: SetNull)
  activity     Activity?     @relation(fields: [activityId], references: [id], onDelete: SetNull)
  submission   Submission?   @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  review       Review?       @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  registration Registration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)

  @@index([tenantId, userId, createdAt])
  @@index([tenantId, eventId, source])
  @@index([userId, source])
  @@map("xp_transactions")
}

/// Definição de missão/tarefa recompensada com XP e possivelmente carta.
model TaskDefinition {
  id       String  @id @default(uuid(7)) @db.Uuid
  tenantId String  @db.Uuid
  eventId  String? @db.Uuid

  slug        String  @db.VarChar(120)
  name        String  @db.VarChar(160)
  description String? @db.Text

  kind    TaskKind     @default(ONE_OFF)
  /// Evento que dispara progresso (ex.: CHECKIN, REVIEW_COMPLETED).
  trigger XpSourceKind
  /// Meta a atingir: { count, activityType, trackId, minutes }
  target  Json         @default("{}")

  xpReward             Int     @default(0)
  rewardCardTemplateId String? @db.Uuid

  /// Janela de validade da missão.
  startsAt         DateTime? @db.Timestamptz(6)
  endsAt           DateTime? @db.Timestamptz(6)
  /// Repetível a cada N horas (0 = não repetível).
  repeatEveryHours Int       @default(0)

  isActive     Boolean @default(true)
  displayOrder Int     @default(0)
  /// Exibir no painel de missões do participante.
  isVisible    Boolean @default(true)

  metadata Json @default("{}")

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  event      Event?             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  rewardCard CardTemplate?      @relation(fields: [rewardCardTemplateId], references: [id], onDelete: SetNull)
  progress   UserTaskProgress[]

  @@unique([tenantId, slug])
  @@index([tenantId, eventId, isActive])
  @@index([tenantId, trigger])
  @@map("task_definitions")
}

model UserTaskProgress {
  id               String @id @default(uuid(7)) @db.Uuid
  tenantId         String @db.Uuid
  userId           String @db.Uuid
  taskDefinitionId String @db.Uuid

  status   TaskProgressStatus @default(NOT_STARTED)
  progress Int                @default(0)
  target   Int                @default(1)

  /// Chave da janela corrente (permite missões diárias/semanais repetíveis).
  periodKey String? @db.VarChar(20)

  startedAt   DateTime? @db.Timestamptz(6)
  completedAt DateTime? @db.Timestamptz(6)
  claimedAt   DateTime? @db.Timestamptz(6)
  expiresAt   DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskDefinition TaskDefinition @relation(fields: [taskDefinitionId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, taskDefinitionId, periodKey])
  @@index([tenantId, userId, status])
  @@index([taskDefinitionId, status])
  @@map("user_task_progress")
}

// ───────────────────────────────────────────────────────────────────────────────
//  CERTIFICAÇÃO
// ───────────────────────────────────────────────────────────────────────────────

model Certificate {
  id         String  @id @default(uuid(7)) @db.Uuid
  tenantId   String  @db.Uuid
  eventId    String  @db.Uuid
  userId     String  @db.Uuid
  activityId String? @db.Uuid

  kind   CertificateKind
  status CertificateStatus @default(QUEUED)

  /// Código público de validação (impresso no QR Code).
  validationCode String @unique @db.VarChar(32)

  /// Snapshot imutável do conteúdo no momento da emissão — o certificado não
  /// muda se o evento for editado depois.
  title             String @db.VarChar(300)
  recipientName     String @db.VarChar(200)
  bodyText          String @db.Text
  /// Carga horária efetivamente cumprida, em MINUTOS.
  workloadMinutes   Int    @default(0)
  /// Detalhamento das atividades que compuseram a carga horária.
  workloadBreakdown Json   @default("[]")

  issuedAt  DateTime? @db.Timestamptz(6)
  expiresAt DateTime? @db.Timestamptz(6)

  /// Objeto gerado no storage.
  storageKey String? @db.VarChar(1024)
  bucket     String? @db.VarChar(120)
  mimeType   String  @default("application/pdf") @db.VarChar(120)
  sizeBytes  BigInt?

  /// SHA-256 do PDF emitido — garante integridade do documento.
  contentHash    String? @db.Char(64)
  /// Assinatura digital destacada (PKCS#7/CMS em base64) ou HMAC.
  signature      String? @db.Text
  /// Identificador da chave usada na assinatura (rotação de chaves).
  signatureKeyId String? @db.VarChar(80)
  signatureAlg   String? @db.VarChar(40)

  /// Verificação pública: contador e último acesso ao link de validação.
  validationCount Int       @default(0)
  lastValidatedAt DateTime? @db.Timestamptz(6)

  /// Falha de geração (para retry pelo worker).
  failureReason String? @db.VarChar(500)
  attempts      Int     @default(0)

  /// Job do BullMQ que gerou/gera este certificado.
  jobId        String? @db.VarChar(120)
  /// Presenças que fundamentaram a emissão (auditoria).
  attendanceId String? @db.Uuid

  revokedAt     DateTime? @db.Timestamptz(6)
  revokedReason String?   @db.VarChar(400)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity   Activity?   @relation(fields: [activityId], references: [id], onDelete: SetNull)
  attendance Attendance? @relation(fields: [attendanceId], references: [id], onDelete: SetNull)

  @@unique([tenantId, userId, eventId, activityId, kind])
  @@index([tenantId, eventId, status])
  @@index([tenantId, userId, status])
  @@index([validationCode])
  @@index([status, createdAt])
  @@map("certificates")
}

// ───────────────────────────────────────────────────────────────────────────────
//  OBSERVABILIDADE & AUDITORIA
// ───────────────────────────────────────────────────────────────────────────────

/// Trilha de auditoria imutável. Gravada pela aplicação (não pelo banco) para
/// capturar ator, IP e contexto de tenant mesmo em operações cross-tenant.
model AuditLog {
  id       String  @default(uuid(7)) @db.Uuid
  tenantId String? @db.Uuid
  userId   String? @db.Uuid

  action     AuditAction
  entityType String      @db.VarChar(80)
  entityId   String?     @db.Uuid

  /// Diff das alterações: { before, after } — com PII mascarada.
  changes   Json    @default("{}")
  /// Metadados da requisição.
  ipAddress String? @db.VarChar(64)
  userAgent String? @db.VarChar(500)
  requestId String? @db.VarChar(80)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// ─────────────────────────────────────────────────────────────────────────────
  ///  CHAVE PRIMÁRIA COMPOSTA — consequência do particionamento (FASE 13)
  /// ─────────────────────────────────────────────────────────────────────────────
  ///  `audit_logs` é particionada por mês em `createdAt` (migração
  ///  `20260917200000_audit_logs_partitioning`). No PostgreSQL a chave de
  ///  particionamento precisa fazer parte de toda chave única da tabela, então a
  ///  PK é `(id, createdAt)`: `id` continua sendo o identificador de negócio, mas
  ///  deixou de bastar para um `findUnique`.
  ///
  ///  Consequência prática: busca por `id` usa `findFirst`/`findMany`. Nenhuma FK
  ///  aponta para `audit_logs`, então nada mais no schema mudou.
  @@id([id, createdAt])
  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

