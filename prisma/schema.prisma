/// De onde a linha de inscrição veio.
///
/// `INDIVIDUAL` — a pessoa escolheu aquela atividade (ou se inscreveu no evento).
/// `EVENT_AUTO` — criada automaticamente porque a pessoa se inscreveu no EVENTO e a
/// atividade é aberta a todos os inscritos (`Activity.requiresRegistration = false`).
///
/// A distinção não é cosmética: ela decide o que a tela mostra ("inscrito
/// automaticamente"), o que o cancelamento da inscrição do evento leva junto (só as
/// automáticas) e o que a exclusão de atividade encontra pela frente.
enum RegistrationOrigin {
  INDIVIDUAL
  EVENT_AUTO
}

/// Como a vaga de uma atividade é confirmada (FASE 34).
///
/// `AUTO` — a inscrição confirma a vaga no ato. É o padrão e o comportamento de tudo
/// o que existia antes desta fase: quem clica, fica.
///
/// `REQUIRED` — a inscrição nasce `PENDING` e a vaga fica RETIDA até a equipe
/// registrar a confirmação (o pagamento, a doação, o item recebido). Vencido o prazo
/// escolhido pelo organizador, a vaga é liberada automaticamente.
///
/// A escolha é do organizador, no cadastro da atividade: sem ela, nada muda.
enum ConfirmationPolicy {
  AUTO
  REQUIRED
}

/// Como a presença foi comprovada — base de auditoria da carga horária.
enum AttendanceSource {
  QR_CODE_CHECKIN
  QR_CODE_CHECKOUT
  MANUAL_STAFF
  SELF_DECLARED
  IMPORTS
}

/// Estado do crachá: revogado deixa de valer no balcão, sem apagar o histórico.
enum CredentialStatus {
  ACTIVE
  REVOKED
}

/// ═══════════════════════════════════════════════════════════════════════════════
///  CRACHÁ DO PARTICIPANTE NO EVENTO (FASE 31)
///
///  ─────────────────────────────────────────────────────────────────────────────
///  POR QUE O CRACHÁ NÃO MORA NA INSCRIÇÃO
///  ─────────────────────────────────────────────────────────────────────────────
///  A inscrição é por (pessoa × evento) E por (pessoa × atividade). Com o crachá
///  na inscrição (`Registration.badgeToken`), quem se inscreveu no evento e em dois
///  minicursos teria TRÊS crachás — e a portaria não saberia qual ler.
///
///  O crachá é da PESSOA no EVENTO: um código opaco, um por par (evento, pessoa),
///  que o monitor lê escolhendo o CONTEXTO (portaria ou atividade). A presença
///  continua sendo por (pessoa × atividade), em `attendances`.
///
///  `Registration.badgeToken` fica como LEGADO CONGELADO: o código novo não escreve
///  mais nele, e a leitura por token antigo continua funcionando até que os crachás
///  impressos antes desta fase saiam de circulação.
/// ═══════════════════════════════════════════════════════════════════════════════
model EventCredential {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @db.Uuid
  eventId  String @db.Uuid
  userId   String @db.Uuid

  /// Código do crachá (`CR-XXXX-XXXX`) — é ele que vai no QR Code. Único GLOBAL,
  /// para que uma leitura não precise de contexto; a RLS limita a busca à instituição.
  code   String           @unique @db.VarChar(32)
  status CredentialStatus @default(ACTIVE)

  /// Quem emitiu. NULO = emitido no backfill da migração (antes de existir emissão).
  issuedById String?  @db.Uuid
  issuedAt   DateTime @default(now()) @db.Timestamptz(6)

  /// Última impressão da etiqueta (a folha pode ser reimpressa; isto guarda a mais recente).
  printedAt   DateTime? @db.Timestamptz(6)
  printedById String?   @db.Uuid

  revokedAt    DateTime? @db.Timestamptz(6)
  revokedById  String?   @db.Uuid
  revokeReason String?   @db.VarChar(300)

  /// Observação da organização (ex.: "crachá de imprensa", "equipe de apoio").
  notes String? @db.VarChar(300)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  event     Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User   @relation("CredentialHolder", fields: [userId], references: [id], onDelete: Cascade)
  issuedBy  User?  @relation("CredentialIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)
  printedBy User?  @relation("CredentialPrintedBy", fields: [printedById], references: [id], onDelete: SetNull)
  revokedBy User?  @relation("CredentialRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)

  /// UM crachá por pessoa por evento — é o que a decisão da fase exige.
  @@unique([eventId, userId])
  @@index([tenantId, eventId, status])
  @@index([tenantId, userId])
  @@map("event_credentials")
}

/// Recado da instituição para um participante (FASE 32): o que aparece na caixa de
/// entrada dele e o que sai por e-mail.
///
/// A mensagem é o FATO e é do participante (não da tela): ela nasce aqui e é o
/// e-mail que sai DEPOIS, pelo outbox da FASE 15. Quem não recebeu o e-mail (endereço
/// inválido, fila fora do ar) continua vendo o recado na plataforma — a comunicação
/// interna não depende do provedor externo.
model ParticipantMessage {
  id       String  @id @default(uuid(7)) @db.Uuid
  tenantId String  @db.Uuid
  /// Destinatário — a caixa de entrada é dele.
  userId   String  @db.Uuid
  /// Evento relacionado, quando o recado é sobre um (opcional: o recado pode ser da
  /// instituição, e o `SetNull` preserva o histórico se o evento for excluído).
  eventId  String? @db.Uuid

  subject String @db.VarChar(140)
  body    String @db.VarChar(2000)

  /// Mesma chave gravada no outbox (`email_messages."dedupeKey"`): liga a mensagem ao
  /// e-mail SEM coluna de referência, porque é ela que o reenvio do job já usa para
  /// não duplicar (FASE 15).
  dedupeKey String @unique @db.VarChar(200)

  /// Agrupa o envio em massa: um lote, N mensagens. NULO = recado individual.
  batchId String? @db.Uuid

  /// Quem enviou. NULO só em dado semeado/importado sem autor conhecido.
  sentById String?  @db.Uuid
  sentAt   DateTime @default(now()) @db.Timestamptz(6)

  /// Quando o participante abriu o recado. É o que permite à instituição saber se a
  /// comunicação chegou a ser LIDA — e não apenas enviada.
  readAt DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation("ParticipantMessageRecipient", fields: [userId], references: [id], onDelete: Cascade)
  event  Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  sentBy User?  @relation("ParticipantMessageSentBy", fields: [sentById], references: [id], onDelete: SetNull)

  /// A CAIXA DE ENTRADA: as mensagens de uma pessoa, da mais nova para a mais antiga.
  @@index([tenantId, userId, sentAt])
  /// O HISTÓRICO da instituição: o que ela mandou, em ordem.
  @@index([tenantId, sentAt])
  @@index([tenantId, batchId])
  @@map("participant_messages")
}

