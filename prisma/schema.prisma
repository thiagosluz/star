// ═══════════════════════════════════════════════════════════════════════════════
//  EventFlow Platform — Canonical Data Model
//  FASE 1 — Infraestrutura & Modelagem
//
//  Estratégia multi-tenant: SHARED SCHEMA + tenant_id + PostgreSQL Row-Level
//  Security (RLS). Ver docs/fase-01-infra-e-modelagem.md (ADR-001..ADR-004).
//
//  Invariantes estruturais:
//   1. Toda tabela de domínio de tenant carrega `tenantId` diretamente
//      (denormalizado quando necessário) para que a policy de RLS seja um
//      predicado de uma única coluna — barato e impossível de contornar por
//      um JOIN esquecido.
//   2. Identidade (`User`) é GLOBAL e não possui RLS. O vínculo
//      pessoa↔instituição vive em `UserTenantProfile` (tenant-scoped).
//   3. Papéis são concedidos por ESCOPO (tenant | event | activity), o que
//      permite acúmulo de papéis e troca de contexto sem perda de sessão.
//
//  Prisma 7: o `url` da datasource NÃO mora mais aqui — ver prisma.config.ts.
// ═══════════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────────────────────────────────────────────────────────
//  ENUMS
// ───────────────────────────────────────────────────────────────────────────────

