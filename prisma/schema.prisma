// ═══════════════════════════════════════════════════════════════════════════════
//  EventFlow Platform — Canonical Data Model
//  FASE 1 — Infraestrutura & Modelagem
//
//  Estratégia multi-tenant: SHARED SCHEMA + tenant_id + PostgreSQL Row-Level
//  Security (RLS). Ver docs/fase-01-infra-e-modelagem.md (ADR-001..ADR-004).
//
//  Invariantes estruturais:
//   1. Toda tabela de domínio de tenant carrega `tenantId` diretamente
//      (denormalizado quando necessário) para que a policy de RLS seja um
//      predicado de uma única coluna — barato e impossível de contornar por
//      um JOIN esquecido.
//   2. Identidade (`User`) é GLOBAL e não possui RLS. O vínculo
//      pessoa↔instituição vive em `UserTenantProfile` (tenant-scoped).
//   3. Papéis são concedidos por ESCOPO (tenant | event | activity), o que
//      permite acúmulo de papéis e troca de contexto sem perda de sessão.
//
//  Prisma 7: o `url` da datasource NÃO mora mais aqui — ver prisma.config.ts.
// ═══════════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────────────────────────────────────────────────────────
//  ENUMS
// ───────────────────────────────────────────────────────────────────────────────

enum TenantStatus {
  PENDING
  ACTIVE
  SUSPENDED
  ARCHIVED
}

/// Plano comercial do tenant. Sobrescreve limites de quota (eventos, storage).
enum TenantPlan {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

/// Vínculo entre uma pessoa global e uma instituição.
enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

/// Natureza do vínculo com a instituição (FASE 14).
///
/// A inscrição pública (FASE 10) passou a criar vínculo para quem se inscreve em
/// evento aberto — correto para dar acesso, mas o modelo não distinguia esse
/// vínculo do vínculo de EQUIPE. Sem a distinção, a lista de membros da instituição
/// aparecia cheia de inscritos e a quota `maxMembers` do plano ficava impossível de
/// aplicar (contar vínculos passou a significar contar o público do evento).
///
/// `MEMBER` consome quota e aparece na lista de quem responde pela instituição.
/// `PARTICIPANT` dá acesso de participante e NÃO consome quota (ver
/// `src/domain/tenancy/membership-rules.ts`).
enum MembershipKind {
  MEMBER
  PARTICIPANT
}

/// Papel RBAC. SUPERADMIN é de PLATAFORMA; OWNER/ADMIN são escopo-tenant; os
/// demais podem ser concedidos por evento ou até por atividade (ex.: coordenador
/// de um único minicurso).
enum RoleKey {
  SUPERADMIN
  OWNER
  ADMIN
  ORGANIZER
  FINANCE
  REVIEWER
  CHAIR
  SPEAKER
  STAFF
  PARTICIPANT
  SPONSOR
}

/// Dimensão à qual uma atribuição de papel pertence.
enum RoleScope {
  /// Governança da PLATAFORMA (FASE 9). Não pertence a instituição alguma: a
  /// atribuição tem `tenantId`, `eventId` e `activityId` NULOS.
  PLATFORM
  TENANT
  EVENT
  ACTIVITY
}

