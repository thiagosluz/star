# ═══════════════════════════════════════════════════════════════════════════════
#  EventFlow — variáveis de ambiente (desenvolvimento local)
#  Copie para `.env` e ajuste. NUNCA versione o `.env` real.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Aplicação ────────────────────────────────────────────────────────────────
# ATENÇÃO — `NODE_ENV` e o build de produção
#
# Este arquivo é carregado pelo Next.js TAMBÉM durante `next build`. Com
# `NODE_ENV=development` aqui, o build quebra na etapa de prerender com:
#
#     TypeError: Cannot read properties of null (reading 'useContext')
#     Export encountered an error on /_global-error/page
#
# Por isso `npm run build` força `NODE_ENV=production` (via cross-env). Se rodar
# `npx next build` DIRETO, exporte a variável antes:
#     Linux/macOS:  NODE_ENV=production npx next build
#     PowerShell:   $env:NODE_ENV="production"; npx next build
NODE_ENV=development
APP_PORT=3000
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Domínio raiz usado na resolução de tenant por subdomínio.
#   localhost  -> tenant via path (/t/<slug>) ou header x-ef-tenant
#   lvh.me     -> qualquer *.lvh.me resolve para 127.0.0.1 (testa subdomínios)
ROOT_DOMAIN=lvh.me
NEXT_PUBLIC_ROOT_DOMAIN=lvh.me

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=eventflow_admin
POSTGRES_PASSWORD=eventflow_dev_password
POSTGRES_DB=eventflow
POSTGRES_PORT=5432

# Role de RUNTIME da aplicação: NÃO é superuser, NÃO tem BYPASSRLS.
# É esta conexão que sofre Row-Level Security.
APP_DB_USER=eventflow_app
APP_DB_PASSWORD=eventflow_app_password

# ─── Conexões ─────────────────────────────────────────────────────────────────
# ADMIN (dona do schema). Usada pela CLI do Prisma, pelo seed e pelo Better Auth.
MIGRATE_DATABASE_URL="postgresql://eventflow_admin:eventflow_dev_password@localhost:5432/eventflow?schema=public"

# RUNTIME (sujeita a RLS). Usada por `withTenant()` em src/lib/db/tenant-client.ts.
APP_DATABASE_URL="postgresql://eventflow_app:eventflow_app_password@localhost:5432/eventflow?schema=public"

# ─── Redis (cache, rate limit, BullMQ) ────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# ─── Object Storage (S3-compatível) ───────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=eventflow_minio
S3_SECRET_KEY=eventflow_minio_secret
S3_FORCE_PATH_STYLE=true

S3_BUCKET_SUBMISSIONS=eventflow-submissions
S3_BUCKET_CERTIFICATES=eventflow-certificates
S3_BUCKET_ASSETS=eventflow-assets
S3_BUCKET_AVATARS=eventflow-avatars
S3_BUCKET_TEMP=eventflow-temp

# ─── MinIO container ──────────────────────────────────────────────────────────
MINIO_ROOT_USER=eventflow_minio
MINIO_ROOT_PASSWORD=eventflow_minio_secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ─── Autenticação (Better Auth) ───────────────────────────────────────────────
# Mínimo de 32 caracteres. Em produção, gere com:
#   openssl rand -base64 48
BETTER_AUTH_SECRET=dev-only-secret-change-me-in-production-min-32-chars
BETTER_AUTH_URL=http://localhost:3000

# ─── Certificados (FASE 6) ────────────────────────────────────────────────────
CERTIFICATE_SIGNING_KEY_ID=dev-key-2025-01
CERTIFICATE_HMAC_SECRET=dev-hmac-secret-change-me

# ─── Testes E2E (Playwright) ──────────────────────────────────────────────────
E2E_BASE_URL=http://localhost:3000

# ─── Testes E2E ────────────────────────────────────────────────────────────────
# Desliga o rate limiter do Better Auth (em memória, por processo). Os testes E2E
# rodam contra o container de produção e disparam dezenas de cadastros do mesmo IP.
RATE_LIMIT_ENABLED=false
