# ═══════════════════════════════════════════════════════════════════════════════
#  EventFlow — variáveis de ambiente (desenvolvimento local)
#  Copie para `.env` e ajuste. NUNCA versione o `.env` real.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Aplicação ────────────────────────────────────────────────────────────────
# ATENÇÃO — `NODE_ENV` e o build de produção
#
# Este arquivo é carregado pelo Next.js TAMBÉM durante `next build`. Com
# `NODE_ENV=development` aqui, o build quebra na etapa de prerender com:
#
#     TypeError: Cannot read properties of null (reading 'useContext')
#     Export encountered an error on /_global-error/page
#
# Por isso `npm run build` força `NODE_ENV=production` (via cross-env). Se rodar
# `npx next build` DIRETO, exporte a variável antes:
#     Linux/macOS:  NODE_ENV=production npx next build
#     PowerShell:   $env:NODE_ENV="production"; npx next build
NODE_ENV=development
APP_PORT=3000
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Contas de teste (SOMENTE desenvolvimento) ────────────────────────────────
# Senha única das contas criadas por `npm run db:seed:dev`. Se ausente, o script
# usa o padrão documentado em docs/contas-de-teste.md.
# O script RECUSA rodar com NODE_ENV=production.
# SEED_TEST_PASSWORD="troque-esta-senha"

# Domínio raiz usado na resolução de tenant por subdomínio.
#   localhost  -> tenant via path (/t/<slug>) ou header x-ef-tenant
#   lvh.me     -> qualquer *.lvh.me resolve para 127.0.0.1 (testa subdomínios)
ROOT_DOMAIN=lvh.me
NEXT_PUBLIC_ROOT_DOMAIN=lvh.me

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=eventflow_admin
POSTGRES_PASSWORD=eventflow_dev_password
POSTGRES_DB=eventflow
POSTGRES_PORT=5432

# Role de RUNTIME da aplicação: NÃO é superuser, NÃO tem BYPASSRLS.
# É esta conexão que sofre Row-Level Security.
APP_DB_USER=eventflow_app
APP_DB_PASSWORD=eventflow_app_password

# ─── Conexões ─────────────────────────────────────────────────────────────────
# ADMIN (dona do schema). Usada pela CLI do Prisma, pelo seed e pelo Better Auth.
MIGRATE_DATABASE_URL="postgresql://eventflow_admin:eventflow_dev_password@localhost:5432/eventflow?schema=public"

# RUNTIME (sujeita a RLS). Usada por `withTenant()` em src/lib/db/tenant-client.ts.
APP_DATABASE_URL="postgresql://eventflow_app:eventflow_app_password@localhost:5432/eventflow?schema=public"

# ─── PgBouncer (FASE 13) ──────────────────────────────────────────────────────
# Pool de conexões em modo TRANSACTION, no perfil `pooler` do docker-compose:
#   docker compose --profile pooler up -d pooler && npm run db:verify:pooling
# Seguro porque o contexto de tenant é `SET LOCAL` (morre no COMMIT) e a aplicação
# não usa recurso de sessão (advisory lock, LISTEN/NOTIFY, prepared statement
# nomeado). Para usar o pooler em produção, aponte o RUNTIME para a 6432:
#   APP_DATABASE_URL="postgresql://eventflow_app:...@localhost:6432/eventflow?schema=public"
PGBOUNCER_PORT=6432
DATABASE_URL_POOLED="postgresql://eventflow_app:eventflow_app_password@localhost:6432/eventflow"

# ─── Particionamento da auditoria (FASE 13) ───────────────────────────────────
# Quantos meses À FRENTE o `npm run db:partitions` mantém criados (agende no host).
PARTITION_MONTHS_AHEAD=2

# ─── Redis (cache, rate limit, BullMQ) ────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# ─── Object Storage (S3-compatível) ───────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=eventflow_minio
S3_SECRET_KEY=eventflow_minio_secret
S3_FORCE_PATH_STYLE=true

S3_BUCKET_SUBMISSIONS=eventflow-submissions
S3_BUCKET_CERTIFICATES=eventflow-certificates
S3_BUCKET_ASSETS=eventflow-assets
S3_BUCKET_AVATARS=eventflow-avatars
S3_BUCKET_TEMP=eventflow-temp

# ─── MinIO container ──────────────────────────────────────────────────────────
MINIO_ROOT_USER=eventflow_minio
MINIO_ROOT_PASSWORD=eventflow_minio_secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ─── Autenticação (Better Auth) ───────────────────────────────────────────────
# Mínimo de 32 caracteres. Em produção, gere com:
#   openssl rand -base64 48
BETTER_AUTH_SECRET=dev-only-secret-change-me-in-production-min-32-chars
BETTER_AUTH_URL=http://localhost:3000

# ─── Certificados (FASE 6) ────────────────────────────────────────────────────
CERTIFICATE_SIGNING_KEY_ID=dev-key-2025-01
CERTIFICATE_HMAC_SECRET=dev-hmac-secret-change-me

# ─── Cofre de sementes do sorteio (FASE 22) ───────────────────────────────────
# Chaveiro VERSIONADO que sela a semente do sorteio (AES-256-GCM), no formato
# `versão:segredo`, separado por vírgula. A MAIOR versão declarada é a que os
# sorteios novos usam; abrir uma semente selada usa a versão GRAVADA no sorteio,
# então girar a chave NÃO invalida compromisso já publicado.
#
# Deixe vazio para usar a chave LEGADA (derivada de BETTER_AUTH_SECRET) — que é o
# que todo sorteio criado antes da FASE 22 usa. Segredo com menos de 16 caracteres
# é recusado, e a tela de sorteios mostra a situação do chaveiro (inclusive erros
# de formatação) antes de alguém apurar no palco.
# Exemplo de rotação: RAFFLE_SEED_KEYS=1:<segredo antigo>,2:<segredo novo>
RAFFLE_SEED_KEYS=

# ─── E-mail transacional (FASE 15) ────────────────────────────────────────────
# Driver do envio:
#   `resend` -> fala com a API do Resend (exige RESEND_API_KEY)
#   `log`    -> NÃO envia: grava a mensagem no outbox e no log (dev e suíte E2E)
# Sem EMAIL_DRIVER definido, o padrão é `resend` apenas em produção COM chave
# presente; fora disso o driver é `log` — ambiente mal configurado não dispara
# e-mail real para endereço de pessoa de verdade.
EMAIL_DRIVER=log
RESEND_API_KEY=

# Remetente. ATENÇÃO ao que a conta do Resend permite:
#
#   • SEM domínio verificado (conta de teste) o Resend só aceita
#     `onboarding@resend.dev` como remetente — e só ENTREGA para o endereço dono
#     da conta. Qualquer outro destinatário volta com erro 403, que aparece no
#     outbox em "Falhas" com a mensagem do provedor.
#   • COM domínio verificado, troque por algo como
#     `EventFlow <nao-responda@seudominio.com.br>` e qualquer destinatário passa a
#     ser aceito.
#
# O remetente de teste abaixo já permite validar a esteira de ponta a ponta hoje.
EMAIL_FROM="EventFlow <onboarding@resend.dev>"
# Responder-para (opcional). Vazio = o destinatário responde ao próprio remetente.
EMAIL_REPLY_TO=

# Prazo (em horas) do aviso "seu parecer está vencendo" — lido pelo job repetível
# `review-deadlines` do worker. 48 h é o padrão combinado com o comitê.
REVIEW_REMINDER_HOURS=48

# ─── Observabilidade (FASE 13) ────────────────────────────────────────────────
# Token do endpoint /api/metrics (formato Prometheus). SEM ele, em produção, o
# endpoint responde 404 — métrica não fica exposta por esquecimento.
#   curl -H "Authorization: Bearer $METRICS_TOKEN" http://localhost:3000/api/metrics
# Gere com: openssl rand -hex 24
METRICS_TOKEN=

# ─── Testes E2E (Playwright) ──────────────────────────────────────────────────
E2E_BASE_URL=http://localhost:3000

# ─── Testes E2E ────────────────────────────────────────────────────────────────
# Desliga o rate limiter do Better Auth. Desde a FASE 13 o contador vive no Redis
# (vale entre instâncias); aqui ele fica desligado porque a suíte E2E dispara
# dezenas de cadastros do mesmo IP contra o container de produção.
RATE_LIMIT_ENABLED=false
