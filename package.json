{
  "name": "eventflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Plataforma SaaS multi-tenant de gestão de eventos acadêmicos, corporativos e comunitários",
  "engines": {
    "node": ">=24.0.0"
  },
  "imports": {
    "#db/prisma-client": "./src/generated/prisma/client.ts"
  },
  "scripts": {
    "dev": "next dev",
    "build": "cross-env NODE_ENV=production next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:migrate:deploy": "prisma migrate deploy && prisma generate && npm run db:rls",
    "db:migrate:status": "prisma migrate status",
    "db:reset": "prisma migrate reset --force",
    "db:rls": "node --env-file=.env prisma/scripts/apply-rls.mjs",
    "db:verify": "node --env-file=.env prisma/scripts/assert-schema-contract.mjs",
    "db:verify:isolation": "node --env-file=.env prisma/scripts/assert-tenant-isolation.mjs",
    "db:verify:pooling": "node --env-file=.env prisma/scripts/verify-pooling.mjs",
    "db:partitions": "node --env-file=.env prisma/scripts/ensure-audit-partitions.mjs",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:dev": "tsx prisma/seed-dev-users.ts",
    "db:setup": "npm run db:migrate && npm run db:rls && npm run db:verify && npm run db:verify:isolation && npm run db:seed",
    "db:setup:dev": "npm run db:setup && npm run db:seed:dev",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v",
    "infra:logs": "docker compose logs -f",
    "infra:ps": "docker compose ps",
    "infra:buckets": "docker compose run --rm minio-init",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1134.0",
    "@aws-sdk/s3-request-presigner": "^3.1134.0",
    "@axe-core/playwright": "^4.13.0",
    "@better-auth/prisma-adapter": "^1.7.5",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-auth": "^1.7.5",
    "bullmq": "^6.3.6",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "17.4.2",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.46.0",
    "next": "^16.3.5",
    "pg": "8.23.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "24.13.5",
    "@types/pg": "8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "jsdom": "^30.0.1",
    "prisma": "7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "^8.3.0",
    "vitest": "5.0.1"
  }
}
